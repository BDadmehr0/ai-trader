+<!DOCTYPE html>
+<html lang="fa" dir="rtl">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>{% block title %}AI BTC Trader{% endblock %}</title>
+  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
+  {% block head %}{% endblock %}
+</head>
+<body>
+  <header class="topbar">
+    <div class="brand">
+      <span class="logo">₿</span>
+      <span>AI BTC Trader</span>
+      <span class="pair" id="pairLabel">{{ (active_coin or 'BTC') }}/USDT</span>
+    </div>
+
+    <!-- Searchable coin switcher -->
+    <div class="coin-switch" id="coinSwitch">
+      <div class="coin-search" id="coinSearch">
+        <span class="coin-search-icon">⌕</span>
+        <input
+          type="text"
+          id="coinInput"
+          autocomplete="off"
+          spellcheck="false"
+          placeholder="جستجوی رمزارز... (مثلاً ETH)"
+          aria-label="جستجوی رمزارز"
+        >
+        <button type="button" class="coin-clear" id="coinClear" title="پاک کردن">×</button>
+      </div>
+      <ul class="coin-list" id="coinList" hidden>
+        <li class="coin-head" id="popularHead">پرمعامله‌ترین</li>
+        <!-- popular coins injected by JS -->
+      </ul>
+    </div>
+
+    <nav class="nav">
+      <a href="/" class="{{ 'active' if request.path == '/' else '' }}">سیگنال لحظه‌ای</a>
+      <a href="/backtest" class="{{ 'active' if request.path == '/backtest' else '' }}">بک‌تست</a>
+    </nav>
+  </header>
+  <main class="container">
+    {% block content %}{% endblock %}
+  </main>
+  <footer class="footer">
+    این سیستم فقط تحلیل تکنیکال ارائه می‌دهد و تضمین سوددهی ندارد.
+  </footer>
+
+  <!-- coin list available on every page -->
+  <script>
+    window.AI_TRADER_COINS = {{ coins | tojson }};
+  </script>
+  <script src="{{ url_for('static', filename='coinswitcher.js') }}"></script>
+  {% block scripts %}{% endblock %}
+</body>
+</html>
diff --git a/webapp/templates/dashboard.html b/webapp/templates/dashboard.html
new file mode 100644
index 0000000..ffbaba7
--- /dev/null
+++ b/webapp/templates/dashboard.html
@@ -0,0 +1,166 @@
+{% extends "base.html" %}
+{% block title %}سیگنال لحظه‌ای — AI BTC Trader{% endblock %}
+
+{% block content %}
+<div class="status-line" id="statusLine">
+  <span id="dataMode">
+    {% if report.live %}
+      <span class="badge live">داده زنده</span>
+    {% else %}
+      <span class="badge demo">داده نمایشی (آفلاین)</span>
+    {% endif %}
+  </span>
+  <span id="updatedAt">آخرین به‌روزرسانی: {{ report.updated_at }}</span>
+</div>
+
+<!-- Main verdict card -->
+<section class="verdict-card verdict-{{ report.verdict|lower }}" id="verdictCard">
+  <div class="verdict-head">
+    <div>
+      <div class="verdict-label">پیشنهاد معاملاتی</div>
+      <div class="verdict" id="verdictText">{{ report.verdict }}</div>
+      <div class="verdict-fa" id="verdictFa">
+        {% if report.verdict == "BUY" %}خرید{% elif report.verdict == "SELL" %}فروش{% else %}صبر / بدون معامله{% endif %}
+      </div>
+    </div>
+    <div class="price-block">
+      <div class="price" id="priceText">{{ "{:,.0f}".format(report.price) }}</div>
+      <div class="pair-small">{{ symbol }}/USDT</div>
+      <div class="change" id="changeText">
+        {{ "%+.2f"|format(report.change_24h_pct) }}% (۲۴ ساعت)
+      </div>
+    </div>
+  </div>
+
+  <div class="confidence">
+    <div class="confidence-label">اطمینان سیگنال</div>
+    <div class="confidence-bar">
+      <div class="confidence-fill" style="width: {{ report.confidence }}%"></div>
+    </div>
+    <div class="confidence-num" id="confText">{{ report.confidence }}%</div>
+  </div>
+
+  <div class="explanation" id="explanationText">{{ report.explanation }}</div>
+</section>
+
+<!-- Chart -->
+<section class="card chart-card">
+  <div class="chart-head">
+    <h2>نمودار قیمت — {{ symbol }}/USDT</h2>
+    <div class="tf-switch">
+      {% for tf_val, tf_label in tf_choices.items() %}
+        <a
+          href="/?symbol={{ symbol }}&tf={{ tf_val }}"
+          class="tf-btn {{ 'active' if tf == tf_val else '' }}"
+        >{{ tf_label }}</a>
+      {% endfor %}
+    </div>
+  </div>
+  <div id="priceChart"></div>
+  <div class="chart-legend" id="chartLegend"></div>
+</section>
+
+<div class="grid-2">
+  <!-- Simple reasons -->
+  <section class="card">
+    <h2>توضیح ساده</h2>
+    <ul class="reasons" id="reasonsList">
+      {% for r in report.reasons %}
+        <li>{{ r }}</li>
+      {% endfor %}
+    </ul>
+  </section>
+
+  <!-- Trade setup -->
+  <section class="card">
+    <h2>سطوح معاملاتی</h2>
+    {% if report.signal != "WAIT" %}
+    <table class="setup-table">
+      <tr><td>وضعیت</td><td id="setupStatus">{{ report.setup.status }}</td></tr>
+      <tr><td>ورود (Entry)</td><td id="setupEntry">{{ "{:,.0f}".format(report.setup.entry) }}</td></tr>
+      <tr><td>حد ضرر (Stop Loss)</td><td class="sl" id="setupSl">{{ "{:,.0f}".format(report.setup.stop_loss) }}</td></tr>
+      <tr><td>هدف اول (TP1)</td><td class="tp" id="setupTp1">{{ "{:,.0f}".format(report.setup.take_profit_1) }}</td></tr>
+      <tr><td>هدف دوم (TP2)</td><td class="tp" id="setupTp2">{{ "{:,.0f}".format(report.setup.take_profit_2) }}</td></tr>
+      <tr><td>نسبت ریسک/بازده TP1</td><td id="setupRr">1:{{ "%.1f"|format(report.setup.risk_reward_1) }}</td></tr>
+    </table>
+    {% else %}
+      <p class="muted">هیچ معامله‌ای پیشنهاد نمی‌شود. منتظر سیگنال بمانید.</p>
+    {% endif %}
+  </section>
+</div>
+
+<div class="grid-2">
+  <!-- Timeframes -->
+  <section class="card">
+    <h2>تحلیل چارچوب‌های زمانی</h2>
+    <table class="data-table">
+      <thead>
+        <tr>
+          <th>بازه</th><th>روند</th><th>نمره</th><th>RSI</th>
+          <th>EMA20</th><th>EMA50</th><th>MACD</th><th>حجم</th>
+        </tr>
+      </thead>
+      <tbody>
+        {% for tf_key, d in report.timeframes.items() %}
+        <tr>
+          <td>{{ tf_key }}</td>
+          <td>
+            <span class="trend trend-{{ d.trend|lower }}">{{ d.trend_fa }}</span>
+          </td>
+          <td>{{ d.score }}</td>
+          <td>{{ "%.1f"|format(d.rsi) }}</td>
+          <td>{{ "{:,.0f}".format(d.ema20) }}</td>
+          <td>{{ "{:,.0f}".format(d.ema50) }}</td>
+          <td>{{ "%+.2f"|format(d.macd_histogram) }}</td>
+          <td>{{ "%.2f"|format(d.volume_ratio) }}x</td>
+        </tr>
+        {% endfor %}
+      </tbody>
+    </table>
+  </section>
+
+  <!-- Support / resistance -->
+  <section class="card">
+    <h2>حمایت و مقاومت</h2>
+    <table class="data-table">
+      <tbody>
+        <tr><td>مقاومت ۲</td><td class="res">{{ "{:,.0f}".format(report.levels.resistance_2) }}</td></tr>
+        <tr><td>مقاومت ۱</td><td class="res">{{ "{:,.0f}".format(report.levels.resistance_1) }}</td></tr>
+        <tr><td>قیمت فعلی</td><td class="now">{{ "{:,.0f}".format(report.price) }}</td></tr>
+        <tr><td>حمایت ۱</td><td class="sup">{{ "{:,.0f}".format(report.levels.support_1) }}</td></tr>
+        <tr><td>حمایت ۲</td><td class="sup">{{ "{:,.0f}".format(report.levels.support_2) }}</td></tr>
+      </tbody>
+    </table>
+  </section>
+</div>
+{% endblock %}
+
+{% block head %}
+<meta http-equiv="refresh" content="60">
+<script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>
+{% endblock %}
+
+{% block scripts %}
+<script>
+  window.AI_TRADER_CHART = {
+    symbol: "{{ symbol }}",
+    tf: "{{ tf }}",
+    candles: {{ candles | tojson }},
+    setup: {
+      signal: "{{ report.signal }}",
+      entry: {{ report.setup.entry }},
+      stop_loss: {{ report.setup.stop_loss }},
+      take_profit_1: {{ report.setup.take_profit_1 }},
+      take_profit_2: {{ report.setup.take_profit_2 }}
+    },
+    levels: {
+      support_1: {{ report.levels.support_1 }},
+      support_2: {{ report.levels.support_2 }},
+      resistance_1: {{ report.levels.resistance_1 }},
+      resistance_2: {{ report.levels.resistance_2 }}
+    },
+    price: {{ report.price }}
+  };
+</script>
+<script src="{{ url_for('static', filename='chart.js') }}"></script>
+{% endblock %}
